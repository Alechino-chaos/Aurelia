{
  "name": "aurelia",
  "version": "0.9.4",
  "private": true,
  "description": "A local-first academic PDF reader",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/run-tool.mjs scripts/dev.mjs",
    "dev:web": "node scripts/run-tool.mjs node_modules/vite/bin/vite.js --host 127.0.0.1",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "build": "node scripts/run-tool.mjs scripts/build.mjs",
    "start": "node scripts/start.mjs",
    "test": "node scripts/run-tool.mjs node_modules/vitest/vitest.mjs run",
    "test:e2e": "npm run build && node scripts/run-tool.mjs node_modules/@playwright/test/cli.js test",
    "dist": "npm run build && node scripts/run-tool.mjs scripts/dist.mjs"
  },
  "dependencies": {
    "katex": "^0.19.0",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "44.7.0",
    "electron-builder": "^26.0.12",
    "pdf-lib": "^1.17.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.0.0"
  },
  "overrides": {
    "katex": "$katex",
    "global-agent": "4.1.3"
  },
  "build": {
    "appId": "com.aurelia.reader",
    "productName": "Aurelia",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "public/branding/aurelia.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "Aurelia-${version}-portable.exe"
    }
  }
}
